{
  "name": "@atlas/protocol",
  "version": "0.1.0",
  "type": "module",
  "files": [
    "dist/",
    "openapi.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./openapi.json": "./openapi.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate": "bash scripts/generate.sh",
    "test": "node --test dist-test/test/*.test.js",
    "verify": "bash verify.sh"
  },
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "@types/node": "24.10.1"
  }
}
