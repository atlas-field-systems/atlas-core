{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "ts",
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": false
  },
  "include": [
    "ts/**/*.ts"
  ]
}
