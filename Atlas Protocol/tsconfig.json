{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": ".",
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": false,
    "lib": [
      "ES2024",
      "DOM",
      "DOM.Iterable"
    ],
    "noEmitOnError": true
  },
  "include": [
    "ts/**/*.ts"
  ]
}
