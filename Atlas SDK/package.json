{
  "name": "@atlas/sdk",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.1",
    "npm": "11.19.0"
  },
  "packageManager": "npm@11.19.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "*.md",
    "package.json"
  ],
  "scripts": {
    "protocol:prepare": "npm --prefix \"../Atlas Core\" run protocol:prepare && node scripts/copy-protocol.mjs",
    "verify:inputs": "node scripts/verify-inputs.mjs",
    "build": "npm run verify:inputs && tsc -p tsconfig.json",
    "test": "npm run build && node scripts/test.mjs",
    "test:package": "node scripts/package.mjs",
    "qualify": "node scripts/package.mjs --source",
    "test:browser": "node scripts/browser.mjs",
    "evidence:verify": "node scripts/verify-evidence.mjs"
  },
  "dependencies": {
    "@atlas/protocol": "file:artifacts/atlas-protocol-0.4.0.tgz",
    "@noble/hashes": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "6.0.2",
    "playwright": "1.64.1"
  },
  "atlasBuild": {
    "protocol": {
      "version": "0.4.0",
      "sha256": "febd040bb997c31d9da4abd35ffdf79ec76f3fa6393185ea5c7efc821a6296e5"
    }
  }
}
