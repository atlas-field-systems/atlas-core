  "components": {
    "schemas": {
      "Position": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "latitude": {
            "$ref": "#/components/schemas/Latitude"
          },
          "longitude": {
            "$ref": "#/components/schemas/Longitude"
          }
        },
        "required": [
          "latitude",
          "longitude"
        ]
      },
      "EntityPatch": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "alias": {
            "type": "string",
            "nullable": true
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          },
          "fixture_component": {
            "$ref": "#/components/schemas/FixtureComponentPatch"
          }
        }
      },
      "Asset": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "alias": {
            "type": "string",
            "nullable": true
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          },
          "position": {
            "$ref": "#/components/schemas/EntityPosition"
          },
          "type": {
            "type": "string",
            "enum": [
              "asset"
            ]
          },
          "operational_status": {
            "type": "string",
            "enum": [
              "unknown",
              "initializing",
              "ready",
              "busy",
              "paused",
              "error",
              "stopped"
            ]
          },
          "battery_percent": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "fixture_component": {
            "$ref": "#/components/schemas/FixtureComponent"
          }
        },
        "required": [
          "id",
          "type",
          "alias",
          "labels",
          "position",
          "operational_status",
          "fixture_component"
        ]
      },
      "Track": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "alias": {
            "type": "string",
            "nullable": true
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          },
          "position": {
            "$ref": "#/components/schemas/EntityPosition"
          },
          "type": {
            "type": "string",
            "enum": [
              "track"
            ]
          },
          "publisher_id": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "type",
          "alias",
          "labels",
          "position",
          "publisher_id"
        ]
      },
      "Geofeature": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "enum": [
              "geofeature"
            ]
          },
          "geometry": {
            "$ref": "#/components/schemas/Position"
          }
        },
        "required": [
          "id",
          "type",
          "geometry"
        ]
      },
      "Entity": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Asset"
          },
          {
            "$ref": "#/components/schemas/Track"
          },
          {
            "$ref": "#/components/schemas/Geofeature"
          }
        ],
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "asset": "#/components/schemas/Asset",
            "track": "#/components/schemas/Track",
            "geofeature": "#/components/schemas/Geofeature"
          }
        }
      },
      "MoveTo": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "move_to"
            ]
          },
          "destination": {
            "$ref": "#/components/schemas/Position"
          }
        },
        "required": [
          "command",
          "destination"
        ],
        "x-atlas-command": {
          "name": "move_to",
          "scheduling": [
            "queued"
          ],
          "success": "arrival_reported_by_asset"
        }
      },
      "Pause": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "pause"
            ]
          }
        },
        "required": [
          "command"
        ],
        "x-atlas-command": {
          "name": "pause",
          "scheduling": [
            "immediate"
          ],
          "success": "suspension_reported_by_asset"
        }
      },
      "Command": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/MoveTo"
          },
          {
            "$ref": "#/components/schemas/Pause"
          }
        ],
        "discriminator": {
          "propertyName": "command",
          "mapping": {
            "move_to": "#/components/schemas/MoveTo",
            "pause": "#/components/schemas/Pause"
          }
        }
      },
      "EvidenceOrigin": {
        "type": "object",
        "nullable": true,
        "additionalProperties": false,
        "properties": {
          "process_generation": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "sequence": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          }
        },
        "required": [
          "process_generation",
          "sequence"
        ]
      },
      "MovementObservationTime": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "observed_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "clock_uncertainty_ms": {
            "type": "number",
            "format": "double",
            "minimum": 0,
            "nullable": true
          }
        },
        "required": [
          "observed_at",
          "clock_uncertainty_ms"
