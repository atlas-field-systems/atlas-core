  "findings": [
    {
      "classification": "specified implementation pitfall",
      "claim": "Native JSON.parse accepts decoded duplicates, replacement-decoded UTF-8, lone surrogates and overflowed numbers.",
      "cases": [
        "nested decoded duplicate",
        "malformed UTF-8",
        "lone high surrogate",
        "overflowed number"
      ]
    },
    {
      "classification": "specified implementation pitfall",
      "claim": "Converting a valid decimal counter to a JS Number changes 9007199254740993 to 9007199254740992.",
      "cases": [
        "broken numeric counter rounds"
      ]
    },
    {
      "classification": "specified implementation pitfall",
      "claim": "Merging a complete Asset section retains fields the sender omitted.",
      "cases": [
        "whole-section replacement removes omitted optional field",
        "broken subfield merge retains obsolete optional field"
      ]
    }
  ],
  "limitations": [
    "Python guards are an instrument, not a proposed SDK dependency or a qualified Go parser.",
    "Unsigned 64-bit counter range is a fixture assumption; Protocol has not selected signedness per counter.",
    "The SQL resource is a minimal specimen, not the complete UpdateAsset schema or HTTP API.",
    "Exact OpenAPI generation, SDK runtime-schema integration, streaming parse memory and full component validation are unrun."
  ]
}
