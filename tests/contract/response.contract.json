  "components": {
    "schemas": {
      "FixtureResponseData": {
        "type": "object",
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "ready",
              "stopped"
            ]
          },
          "label": {
            "type": "string"
          },
          "result": {
            "$ref": "#/components/schemas/FixtureResponsePayload"
          }
        },
        "required": [
          "state",
          "result"
        ]
      },
      "FixtureReadResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ResponseContext"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "$ref": "#/components/schemas/FixtureResponseData"
              }
            },
            "required": [
              "data"
            ]
          }
        ]
      },
      "FixtureResponsePayload": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/FixtureResponseValue"
          },
          {
            "$ref": "#/components/schemas/FixtureResponseCount"
          }
        ],
        "discriminator": {
          "propertyName": "kind"
        }
      },
      "FixtureResponseValue": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "value"
            ]
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "value"
        ]
      },
      "FixtureResponseCount": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "count"
            ]
          },
          "count": {
            "$ref": "#/components/schemas/DecimalCounter"
          }
        },
        "required": [
          "kind",
          "count"
        ]
      },
      "FixtureMutationEnvelopeResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/MutationResponseContext"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "$ref": "#/components/schemas/FixtureResponseData"
              }
            },
            "required": [
              "data"
            ]
          }
        ]
      },
      "FixtureResponseError": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Error"
          },
          {
            "type": "object",
            "required": [
              "dataset_id"
            ]
          }
        ]
      },
      "FixtureRawOpenAPI": {
        "type": "object",
        "properties": {
          "openapi": {
            "type": "string",
            "enum": [
              "3.0.3"
            ]
          },
          "info": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "version": {
                "type": "string"
              }
            },
            "required": [
              "title",
              "version"
            ]
          },
          "paths": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "openapi",
          "info",
          "paths"
        ]
      }
    },
    "headers": {
      "FixtureResponseReceipt": {
        "required": true,
