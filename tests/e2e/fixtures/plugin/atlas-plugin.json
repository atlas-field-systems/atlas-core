{
  "id": "fixture",
  "release": "1.0.0",
  "image": "atlas-fixture-plugin:1.0.0",
  "port": 8082,
  "capabilities": [
    {
      "name": "fixture.work",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label"],
        "properties": {
          "label": { "type": "string", "maxLength": 64 },
          "hold": { "type": "boolean" },
          "fail": { "type": "string", "maxLength": 256 }
        }
      }
    }
  ]
}
